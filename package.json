{
  "name": "dsh-theme-mls-desktop",
  "version": "0.4.0",
  "description": "Marathon 风格的 FUI + 编辑排印故障主题，面向 deepseekHarness 桌面端（Electron）：透明冷启动入场、分阶段鲸鱼揭幕、原生 caption 按钮交接、内置的每轮 token 结算（费用 / 用量 / 用时），以及任务完成时的四拍收尾动画（反向红 S 扫屏 → 矩阵像素定格 → 渐黑 → 玻璃方块揭示界面 + 绿色横幅遮罩）。全部图形程序化生成，不含 Bungie / Marathon 版权素材。",
  "license": "MIT",
  "private": false,
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "postinstall": "node postinstall.cjs",
    "patch": "node shell-patch/auto.cjs",
    "patch:check": "node shell-patch/auto.cjs --check",
    "patch:revert": "node shell-patch/revert.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "index.js",
    "postinstall.cjs",
    "cordis.patch.yml",
    "billing/",
    "assets/",
    "shell-patch/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "fui",
    "glitch",
    "marathon",
    "desktop",
    "electron"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALPDM00/dsh-theme-mls-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/ALPDM00/dsh-theme-mls-desktop/issues"
  },
  "homepage": "https://github.com/ALPDM00/dsh-theme-mls-desktop#readme"
}
